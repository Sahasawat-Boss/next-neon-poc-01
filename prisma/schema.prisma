generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Todo {
  id          Int         @id @default(autoincrement())
  title       String
  completed   Boolean     @default(false)
  description String?
  status      String?
  startDate   DateTime    @default(now())
  dueDate     DateTime?
  createdAt   DateTime    @default(now())
  images      TodoImage[]
}

model TodoImage {
  id        Int      @id @default(autoincrement())
  todoId    Int
  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  name      String
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  todoTitle String
  action    String
  createdAt DateTime @default(now())
}

model PageContent {
  id          Int      @id @default(autoincrement())
  page        String   @unique
  heading     String
  description String?
  updatedAt   DateTime @updatedAt
}
